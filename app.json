{
  "expo": {
    "name": "اخبار الكرة العالمية",
    "slug": "akhbar-al-kora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akhbarkora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akhbarkora.mobile",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFBF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akhbarkora.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "اخبار الكرة العالمية",
      "shortName": "اخبار الكرة العالمية"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFBF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
